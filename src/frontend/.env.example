# API URL for the Strapi backend
NUXT_PUBLIC_API_URL=http://localhost:1337
NUXT_PUBLIC_BRAND_NAME=WPBrigade
NUXT_PUBLIC_BRAND_LOGO_URL=/wpbrigade-logo.png
NUXT_PUBLIC_BRAND_PRIMARY_COLOR=#3458eb
# LinkedIn company page id for "Add to profile" links. Numeric only.
# Leave blank to have LinkedIn match your company by name instead.
NUXT_PUBLIC_BRAND_LINKEDIN_ORGANIZATION_ID=

# Google Analytics 4 measurement ID (optional — omit to disable analytics)
# NUXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# The origin this app is served from. Used for canonical links, the sitemap,
# OG tags and the QR codes printed on certificates - so in production it must
# be the certificate site's own host, not the marketing site.
# Defaults to https://bootcamp.wpbrigade.com (see nuxt.config.ts).
# NUXT_PUBLIC_WEBSITE_URL=https://bootcamp.wpbrigade.com

# OAuth / OIDC providers enabled for "Sign in with …" buttons.
# Comma-separated list of Strapi users-permissions provider names:
# google, github, discord, facebook, twitter, etc.
# Leave empty to hide all OAuth buttons.
# NUXT_PUBLIC_OAUTH_PROVIDERS=google,github
