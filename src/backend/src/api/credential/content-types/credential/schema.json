{
  "kind": "collectionType",
  "collectionName": "credentials",
  "info": {
    "singularName": "credential",
    "pluralName": "credentials",
    "displayName": "Credential",
    "description": "Open Badges 3.0 Credential (Badge Award)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "credentialId": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 36,
      "maxLength": 255,
      "regex": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "json",
      "default": ["VerifiableCredential", "OpenBadgeCredential"]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "issuanceDate": {
      "type": "datetime",
      "required": true
    },
    "expirationDate": {
      "type": "datetime"
    },
    "achievement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::achievement.achievement",
      "inversedBy": "credentials"
    },
    "achievementDocumentId": {
      "type": "string",
      "private": true
    },
    "issuer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "inversedBy": "issuedCredentials"
    },
    "issuerDocumentId": {
      "type": "string",
      "private": true
    },
    "recipient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "inversedBy": "receivedCredentials"
    },
    "recipientName": {
      "type": "string",
      "description": "The recipient's name as it was awarded, printed on the certificate. Held here as well as on the profile because a certificate is a record of something that happened: the name on it must not change when the person is later issued another one under a different spelling, and must survive the profile row being replaced."
    },
    "evidence": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evidence.evidence",
      "mappedBy": "credential"
    },
    "narrative": {
      "type": "text"
    },
    "proof": {
      "type": "component",
      "repeatable": true,
      "component": "badge.proof"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocationReason": {
      "type": "text"
    },
    "statusList": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::revocation-list.revocation-list"
    },
    "statusListIndex": {
      "type": "integer"
    }
  }
} 